# Copy this file to .streamlit/secrets.toml and fill it in.
# secrets.toml is git-ignored: never commit the real one.
# On Streamlit Cloud, paste the same content into App settings -> Secrets.

# Step 5: password asked before the app shows anything.
APP_PASSWORD = ""

# Step 2 and 4: the two agents. Model names live here, not in the code.
ANTHROPIC_API_KEY = ""
LOGGER_MODEL = "claude-haiku-5-5"
BRIEF_MODEL = "claude-sonnet-5-5"

# Step 3: voice transcription.
OPENAI_API_KEY = ""

# Step 1: the Google Sheet. The ID is the part of the Sheet's URL between
# /d/ and /edit. Share the Sheet (Editor) with the service account's email.
SHEET_ID = ""

# Step 4: the end-of-day email.
FRIEND_EMAIL = ""
GMAIL_ADDRESS = ""
GMAIL_APP_PASSWORD = ""

# Step 1: the service account key. Copy every field of the downloaded JSON
# key here. Keep private_key on one line with its \n escapes as they are.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
