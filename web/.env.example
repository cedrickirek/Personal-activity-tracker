# Copy to .env.local for local development, and set the same names in the
# Vercel project (Settings > Environment Variables). Never commit real values.

# The app's login password. Long, and not used anywhere else.
APP_PASSWORD=

# Signs the login cookie. A long random string (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs every device out.
SESSION_SECRET=

# From the Sheet's URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# From the service account's JSON key: "client_email" and "private_key".
# The key can be pasted with real line breaks, or on one line with \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional. The tab the app writes to; "Activities" when empty.
# Locally, use a separate tab so tests don't mix with real days:
ACTIVITIES_TAB=Activities-dev
